<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/spacing_xs"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <RelativeLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="H,16:9"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardCornerRadius="@dimen/shape_card"
            app:cardElevation="@dimen/elevation_0"
            app:cardBackgroundColor="?attr/colorSurfaceContainer"
            app:cardPreventCornerOverlap="true"
            android:layout_margin="@dimen/spacing_xs">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/colorSurfaceContainerHigh" />

            <!-- Title placeholder -->
            <View
                android:layout_width="220dp"
                android:layout_height="14dp"
                android:layout_marginTop="@dimen/spacing_md"
                android:layout_marginStart="@dimen/spacing_sm"
                android:background="?attr/colorSurfaceContainerHighest" />

            <!-- Author placeholder -->
            <View
                android:layout_width="140dp"
                android:layout_height="10dp"
                android:layout_marginTop="36dp"
                android:layout_marginStart="@dimen/spacing_sm"
                android:background="?attr/colorSurfaceContainerHighest" />

            <!-- Duration badge placeholder -->
            <View
                android:layout_width="40dp"
                android:layout_height="16dp"
                android:layout_gravity="bottom|start"
                android:layout_margin="@dimen/spacing_xs"
                android:background="?attr/colorSurfaceContainerHighest" />

            <!-- Action buttons placeholders -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="bottom|end"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_xs">

                <View
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="@dimen/spacing_xxs"
                    android:background="?attr/colorSurfaceContainerHighest" />

                <View
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/colorSurfaceContainerHighest" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>
    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
