<resources>
    <style name="Theme.BottomSheet" parent="BaseTheme">
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="preferenceTheme">@style/PreferenceTheme</item>
    </style>

    <style name="Divider">
        <item name="android:background">@color/light_grey</item>
    </style>

    <style name="Divider.Horizontal" parent="Divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginBottom">10dp</item>
    </style>

    <style name="Divider.Vertical" parent="Divider">
        <item name="android:layout_width">1dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:layout_marginEnd">5dp</item>
        <item name="android:layout_marginStart">5dp</item>
    </style>

    <style name="ShapeAppearanceOverlay.Avatar" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">5dp</item>
    </style>

    <style name="CircleImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="ShapeAppearanceOverlay.Avatar2" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">7dp</item>
    </style>

    <style name="ShapeAppearanceOverlay.RightCorner" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeBottomRight">10dp</item>
        <item name="backgroundTint">#80000000</item>
    </style>

    <style name="ShapeAppearanceOverlay.Chip.Rounded" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">@dimen/shape_chip</item>
        <item name="cornerSizeTopRight">@dimen/shape_chip</item>
        <item name="cornerSizeBottomLeft">@dimen/shape_chip</item>
        <item name="cornerSizeBottomRight">@dimen/shape_chip</item>
    </style>

    <!-- Glass-era shape tokens -->
    <style name="ShapeAppearance.YTDLnis.Card" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/shape_card</item>
    </style>

    <style name="ShapeAppearance.YTDLnis.Sheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/shape_sheet</item>
    </style>

    <style name="ShapeAppearance.YTDLnis.Chip" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/shape_chip</item>
    </style>

    <style name="ShapeAppearance.YTDLnis.Button" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/shape_button</item>
    </style>

    <style name="ShapeAppearance.YTDLnis.Small" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/shape_small</item>
    </style>

    <style name="ShapeAppearance.YTDLnis.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/shape_dialog</item>
    </style>

    <style name="ShapeAppearanceOverlay.YTDLnis.Card" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">@dimen/shape_card</item>
    </style>

    <style name="ShapeAppearanceOverlay.YTDLnis.Chip" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerSize">@dimen/shape_chip</item>
    </style>

    <!-- Glass card widget -->
    <style name="Widget.YTDLnis.Card.Glass" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/shape_card</item>
        <item name="cardElevation">@dimen/elevation_glass</item>
        <item name="strokeColor">@color/glass_stroke</item>
        <item name="strokeWidth">@dimen/glass_stroke</item>
        <item name="cardBackgroundColor">@color/glass_surface_strong</item>
    </style>

    <style name="Widget.YTDLnis.BottomNavigationView.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">?attr/colorSecondaryContainer</item>
        <item name="android:width">56dp</item>
        <item name="android:height">28dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.YTDLnis.Chip</item>
    </style>

    <style name="Preference.SwitchPreferenceCompat.Material3" parent="@style/Preference.SwitchPreferenceCompat.Material">
        <item name="widgetLayout">@layout/preferece_material_switch</item>
    </style>

    <style name="snackBarStyle" parent="@style/Widget.Material3.Snackbar">
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.Corner.ExtraLarge</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="maxLines">2</item>
        <item name="animationMode">slide</item>
    </style>

    <style name="FullScreenDialogTheme" parent="MaterialAlertDialog.Material3">
        <item name="android:windowIsFloating">false</item>
    </style>

    <style name="PreferenceTheme" parent="PreferenceThemeOverlay">
        <item name="singleLineTitle">false</item>
    </style>

    <style name="MyZeroSizeTextAppearance">
        <item name="android:textSize">0sp</item>
    </style>

</resources>
