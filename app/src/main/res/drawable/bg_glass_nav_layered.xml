<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_nav" />
        </shape>
    </item>
    <!-- Top edge crystal line -->
    <item android:bottom="-1dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="@dimen/glass_stroke"
                android:color="@color/glass_highlight" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <!-- Soft top sheen -->
    <item android:height="24dp" android:gravity="top">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#18FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
